datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  menus     Menu[]
  sizes     Size[]
  units     Unit[]
}

model Size {
  id         Int       @id @default(autoincrement())
  name       String
  createdAt  DateTime  @default(now())

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  units      Unit[]    // 🟢 ເພີ່ມ Relation ໄປຫາ Unit
  menus      Menu[]
}

model Unit {
  id         Int       @id @default(autoincrement())
  name       String
  createdAt  DateTime  @default(now())

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sizeId     Int?      // 🟢 ເພີ່ມ FK ເຊື່ອມຫາ Size
  size       Size?     @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  menus      Menu[]
}

model Menu {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  imageUrl    String?
  createdAt   DateTime @default(now())

  // Foreign Keys
  categoryId  Int?
  sizeId      Int?
  unitId      Int?

  // Relations
  category    Category? @relation(fields: [categoryId], references: [id])
  size        Size?     @relation(fields: [sizeId], references: [id])
  unit        Unit?     @relation(fields: [unitId], references: [id])
}

model Order {
  id         Int      @id @default(autoincrement())
  customer   String
  totalPrice Float
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}