datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Material {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  categories Category[]
  stocks     Stock[]    // 🟢 ເພີ່ມRelation ຂາກັບຫາ Stock
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String
  createdAt  DateTime  @default(now())

  materialId Int?      // FK ເຊື່ອມ Material
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  sizes      Size[]
  units      Unit[]
  menus      Menu[]    // 🟢 Relation ຂາກັບຫາ Menu
  stocks     Stock[]   // 🟢 ເພີ່ມRelation ຂາກັບຫາ Stock
}

model Size {
  id         Int       @id @default(autoincrement())
  name       String
  createdAt  DateTime  @default(now())

  categoryId Int?      // FK ເຊື່ອມ Category
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  units      Unit[]
  menus      Menu[]    // 🟢 Relation ຂາກັບຫາ Menu
  stocks     Stock[]   // 🟢 ເພີ່ມRelation ຂາກັບຫາ Stock
}

model Unit {
  id         Int       @id @default(autoincrement())
  name       String
  createdAt  DateTime  @default(now())

  categoryId Int?      // FK ເຊື່ອມ Category
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sizeId     Int?      // FK ເຊື່ອມ Size
  size       Size?     @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  menus      Menu[]    // 🟢 Relation ຂາກັບຫາ Menu
  stocks     Stock[]   // 🟢 ເພີ່ມRelation ຂາກັບຫາ Stock
}

model Menu {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  imageUrl    String?
  createdAt   DateTime  @default(now())

  // Foreign Keys
  categoryId  Int?
  sizeId      Int?
  unitId      Int?

  // Relations
  category    Category? @relation(fields: [categoryId], references: [id])
  size        Size?     @relation(fields: [sizeId], references: [id])
  unit        Unit?     @relation(fields: [unitId], references: [id])
}

model Stock {
  id          Int      @id @default(autoincrement())
  materialId  Int?
  categoryId  Int?
  sizeId      Int?
  unitId      Int?
  quantity    Float    @default(0) // จำนวนรวมสะสมทั้งหมดในสต็อก
  updatedAt   DateTime @updatedAt

  material    Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  size        Size?     @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  imports     StockImport[]
}

model StockImport {
  id          Int      @id @default(autoincrement())
  stockId     Int
  quantity    Float    // จำนวนที่นำเข้าครั้งนี้
  importDate  DateTime @default(now()) // วันที่นำเข้า
  note        String?

  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
}